"""Hackathon Control / Teams Leaderboard Server.

Serves an interactive multi-user Hackathon Control leaderboard on port 7400
and accepts real `agentplay` session map uploads (.json or .json.gz) via
POST /api/upload or the browser Upload Session button / drag-and-drop.
"""

from __future__ import annotations

import argparse
import base64
from datetime import UTC, datetime
import gzip
from http import HTTPStatus
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
import json
import os
from pathlib import Path
import re
import threading
from typing import Any
from urllib.parse import parse_qs, urlsplit

try:
    from agentplay import facts as ap_facts
    from agentplay import health as ap_health
except ImportError:
    ap_facts = None
    ap_health = None


BASE_DIR = Path(__file__).resolve().parent
DATA_FILE = BASE_DIR / "leaderboard_data.json"
UPLOADS_DIR = BASE_DIR / "uploaded_sessions"
MAX_UPLOAD_BYTES = 25 * 1024 * 1024  # 25 MB compressed or raw map
SPARKLINE_BUCKETS = 24
_LOCK = threading.Lock()


